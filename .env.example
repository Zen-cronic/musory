# Atlas cluster host only, for example cluster0.xxxxx.mongodb.net
MONGODB_HOST=
MONGODB_DB=edmRoom
# The server's login: readWrite + dbAdmin on edmRoom
APP_DB_USER=
APP_DB_PASSWORD=
# Each venue's login: built-in read role on its own View only
COPPER_DB_USER=
COPPER_DB_PASSWORD=
BASEMENT_DB_USER=
BASEMENT_DB_PASSWORD=
# Optional: read on v_discoverable only (venue suggestions)
DISCOVERY_DB_USER=
DISCOVERY_DB_PASSWORD=
VOYAGE_API_KEY=
ELEVENLABS_API_KEY=
TOMBSTONE_HMAC_KEY=
PORT=4377
# Set LAN=1 to let phones on the same Wi-Fi reach the laptop
LAN=

# Features (the submitted build runs with these on)
# Live ElevenLabs Music: rooms make a new track when the crowd's taps move them
MUSIC_LIVE=1
# Forget me's follow-up checks run as a LangGraph job with a MongoDB checkpointer
FORGET_GRAPH=1
# "What was that track?" search on the guest page
FIND_TRACK=1
# Reorder its results with Voyage rerank
FIND_RERANK=1
# "Tell the room what you want": a guest's words become one like on the closest track
VIBE_TAP=1
# LangSmith for `pnpm eval` (optional; leave empty to print results only)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=musory
# Only requests carrying this header value may use room controls from another device (optional)
ADMIN_TOKEN=
